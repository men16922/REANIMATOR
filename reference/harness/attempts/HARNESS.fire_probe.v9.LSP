;; REANIMATOR G3 probe harness (work copy only). Fixed input incl. fire button (b2) and mouse.
;; Logs ammo, weapon type, top-half object state/aistate/angle suggestion and focus state per call.
(load "abuse.lsp")
(perm-space)
(setq h_file "hlog.txt")
(setq h_mode "ab")
(setq h_n 0)
(setq h_end 120)
(tmp-space)
(defun h_fire (n) (if (and (>= n 30) (< n 60)) T nil))
(defun get_local_input ()
  (if (bg)
      (let ((fire (h_fire h_n)))
        (open_file h_file h_mode
                   (print (list h_n (game_tick) (if fire 1 0) (total_objects)
                                (ammo_total (current_weapon_type)) (current_weapon_type)
                                (with_object (bg) (list (x) (y) (state) (aistate)))
                                (if (> (total_objects) 0)
                                    (with_obj0 (list (x) (y) (state) (aistate) (player_angle_suggestion)))
                                  nil))))
        (perm-space)
        (setq h_n (+ h_n 1))
        (tmp-space)
        (if (> h_n h_end) (quit))
        (list 0 0 nil fire 0 290 110))
    (list 0 0 nil nil 0 290 110)))
