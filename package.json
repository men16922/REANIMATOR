{
  "name": "reanimator",
  "private": true,
  "version": "1.1.0",
  "description": "REANIMATOR: a 3D side-view sci-fi metroidvania that runs in your browser.",
  "keywords": ["abuse", "game-restoration", "reverse-engineering", "metroidvania", "threejs", "webgl", "typescript"],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "test:engine": "node --test tests/",
    "reference:verify": "node tools/reference/verify.ts",
    "reference:holdout": "node tools/reference/verify.ts --holdout",
    "build": "vite build",
    "meshy:terrain": "node tools/meshy/terrain-kit.ts",
    "test:e2e": "VITE_DEBUG_HOOKS=1 vite build --logLevel warn --outDir dist-debug --emptyOutDir && node tools/smoke/smoke.ts"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
